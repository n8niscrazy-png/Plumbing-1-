# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/plumbing_systems?schema=public"

# ─────────────────────────────────────────────
# Site / App
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="Plumbing Systems"
NEXT_PUBLIC_COMPANY_PHONE="(555) 123-4567"

# ─────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_TO_LEADS="leads@yourdomain.com"
EMAIL_TO_CAREERS="careers@yourdomain.com"

# ─────────────────────────────────────────────
# Authentication (NextAuth.js)
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# ─────────────────────────────────────────────
# Cloudinary (image uploads)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────────────────────────
# Google (Maps, Analytics, Reviews)
# ─────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GOOGLE_PLACE_ID=""

# ─────────────────────────────────────────────
# Wisetack Financing
# ─────────────────────────────────────────────
WISETACK_API_KEY=""
WISETACK_MERCHANT_ID=""

# ─────────────────────────────────────────────
# Misc / Feature Flags
# ─────────────────────────────────────────────
NODE_ENV="development"
