generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Lead Management
// ─────────────────────────────────────────────

model Lead {
  id            String      @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String
  address       String?
  city          String?
  zipCode       String?
  serviceType   ServiceType
  urgency       Urgency     @default(STANDARD)
  description   String      @db.Text
  source        LeadSource  @default(WEBSITE)
  status        LeadStatus  @default(NEW)
  preferredDate DateTime?
  preferredTime String?
  assignedTo    User?       @relation(fields: [assignedToId], references: [id])
  assignedToId  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  notes         LeadNote[]
  appointments  Appointment[]

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}

model LeadNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
}

enum ServiceType {
  RESIDENTIAL_REPAIR
  RESIDENTIAL_INSTALL
  COMMERCIAL_REPAIR
  COMMERCIAL_INSTALL
  DRAIN_CLEANING
  WATER_HEATER
  SEWER_LINE
  GAS_LINE
  EMERGENCY
  NEW_CONSTRUCTION
  REMODEL
  MAINTENANCE
  INSPECTION
  OTHER
}

enum Urgency {
  EMERGENCY
  URGENT
  STANDARD
  FLEXIBLE
}

enum LeadSource {
  WEBSITE
  PHONE
  GOOGLE
  FACEBOOK
  REFERRAL
  WISETACK
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  LOST
}

// ─────────────────────────────────────────────
// Appointments / Scheduling
// ─────────────────────────────────────────────

model Appointment {
  id            String            @id @default(cuid())
  lead          Lead              @relation(fields: [leadId], references: [id])
  leadId        String
  technician    User?             @relation(fields: [technicianId], references: [id])
  technicianId  String?
  scheduledAt   DateTime
  duration      Int               @default(60)
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?           @db.Text
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([scheduledAt])
  @@index([technicianId, scheduledAt])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─────────────────────────────────────────────
// Users / Auth
// ─────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  role          UserRole      @default(STAFF)
  passwordHash  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  assignedLeads Lead[]
  appointments  Appointment[]
  notes         LeadNote[]
  blogPosts     BlogPost[]
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  TECHNICIAN
}

// ─────────────────────────────────────────────
// Services
// ─────────────────────────────────────────────

model Service {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  shortDesc     String          @db.VarChar(200)
  description   String          @db.Text
  category      ServiceCategory
  iconName      String
  featured      Boolean         @default(false)
  sortOrder     Int             @default(0)
  metaTitle     String?
  metaDesc      String?         @db.VarChar(160)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category, featured])
}

enum ServiceCategory {
  RESIDENTIAL
  COMMERCIAL
  EMERGENCY
  SPECIALTY
}

// ─────────────────────────────────────────────
// Testimonials
// ─────────────────────────────────────────────

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  location    String?
  content     String   @db.Text
  rating      Int      @default(5)
  serviceType String?
  featured    Boolean  @default(false)
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// Blog
// ─────────────────────────────────────────────

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String   @db.VarChar(300)
  content       String   @db.Text
  featuredImage String?
  published     Boolean  @default(false)
  publishedAt   DateTime?
  metaTitle     String?
  metaDesc      String?  @db.VarChar(160)
  author        User     @relation(fields: [authorId], references: [id])
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, publishedAt])
}

// ─────────────────────────────────────────────
// Gallery
// ─────────────────────────────────────────────

model GalleryImage {
  id          String   @id @default(cuid())
  url         String
  alt         String
  caption     String?
  category    String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// Careers
// ─────────────────────────────────────────────

model JobPosting {
  id            String           @id @default(cuid())
  title         String
  slug          String           @unique
  description   String           @db.Text
  requirements  String           @db.Text
  benefits      String?          @db.Text
  type          JobType          @default(FULL_TIME)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  applications  JobApplication[]
}

model JobApplication {
  id          String            @id @default(cuid())
  job         JobPosting        @relation(fields: [jobId], references: [id])
  jobId       String
  firstName   String
  lastName    String
  email       String
  phone       String
  resumeUrl   String?
  coverLetter String?           @db.Text
  status      ApplicationStatus @default(NEW)
  createdAt   DateTime          @default(now())
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  APPRENTICE
}

enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
}

// ─────────────────────────────────────────────
// Site Settings (key-value store)
// ─────────────────────────────────────────────

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}
